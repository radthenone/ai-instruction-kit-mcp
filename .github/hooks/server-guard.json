{
  "version": 1,
  "guard": "auto",
  "defaults": [
    {
      "id": "docker",
      "kind": "deny",
      "pattern": "^\\s*docker(?=\\s|$)",
      "reason": "kontenery tylko w CI — na hoście działają cudze kontenery"
    },
    {
      "id": "docker-compose",
      "kind": "deny",
      "pattern": "^\\s*docker\\s+compose(?=\\s|$)",
      "reason": "kontenery tylko w CI — na hoście działają cudze kontenery"
    },
    {
      "id": "docker-compose-bin",
      "kind": "deny",
      "pattern": "^\\s*docker-compose(?=\\s|$)",
      "reason": "kontenery tylko w CI — na hoście działają cudze kontenery"
    },
    {
      "id": "podman",
      "kind": "deny",
      "pattern": "^\\s*podman(?=\\s|$)",
      "reason": "kontenery tylko w CI — na hoście działają cudze kontenery"
    },
    {
      "id": "docker-ps",
      "kind": "allow",
      "pattern": "^\\s*(?:docker|podman)\\s+(?:ps|images|inspect|version|info)(?=\\s|$)",
      "reason": "odczyt stanu kontenerów"
    },
    {
      "id": "docker-logs",
      "kind": "allow",
      "pattern": "^\\s*(?:docker|podman)\\s+logs(?=\\s|$)(?!.*\\s(?:-[a-zA-Z]*f[a-zA-Z]*|--follow)(?=\\s|$))",
      "reason": "odczyt logów bez follow"
    },
    {
      "id": "docker-logs-follow",
      "kind": "deny",
      "pattern": "^\\s*(?:docker|podman)\\s+logs(?=\\s|$).*\\s(?:-[a-zA-Z]*f[a-zA-Z]*|--follow)(?=\\s|$)",
      "reason": "follow logów trzyma proces i strumień — użyj `docker logs` bez `-f`"
    },
    {
      "id": "docker-compose-config",
      "kind": "deny",
      "pattern": "^\\s*docker\\s+compose\\s+config(?=\\s|$)",
      "reason": "kontenery tylko w CI — na hoście działają cudze kontenery"
    },
    {
      "id": "docker-compose-ps",
      "kind": "allow",
      "pattern": "^\\s*(?:docker|podman)(?:\\s+|-)compose\\s+ps(?=\\s|$)",
      "reason": "odczyt stanu kontenerów"
    },
    {
      "id": "uv-sync",
      "kind": "deny",
      "pattern": "^\\s*uv\\s+(sync|add|remove|lock)(?=\\s|$)",
      "reason": "instalacja kompiluje zależności natywne — lockfile zmienia się na PC albo w CI"
    },
    {
      "id": "uv-pip-install",
      "kind": "deny",
      "pattern": "^\\s*uv\\s+pip\\s+(?:install|sync)(?=\\s|$)",
      "reason": "instalacja kompiluje zależności natywne — lockfile zmienia się na PC albo w CI"
    },
    {
      "id": "uv-tool-install",
      "kind": "deny",
      "pattern": "^\\s*uv\\s+tool\\s+install(?=\\s|$)",
      "reason": "`uv tool install` pobiera paczkę z sieci — narzędzia instaluj na PC albo w CI"
    },
    {
      "id": "pip-install",
      "kind": "deny",
      "pattern": "^\\s*pip(?:3(?:\\.\\d+)?)?\\s+install(?=\\s|$)",
      "reason": "instalacja kompiluje zależności natywne — zależności zmieniają się na PC albo w CI"
    },
    {
      "id": "uv-run",
      "kind": "deny",
      "pattern": "^\\s*uv\\s+run(?=\\s|$)(?!.*--no-sync)(?!.*--with(?:-requirements|-editable)?(?=[\\s=]|$))",
      "reason": "`uv run` bez `--no-sync` synchronizuje i kompiluje — użyj `uv run --no-sync` albo `UV_NO_SYNC=1`"
    },
    {
      "id": "uv-run-no-sync",
      "kind": "allow",
      "pattern": "^\\s*uv\\s+run(?=\\s|$)(?!.*--with(?:-requirements|-editable)?(?=[\\s=]|$)).*?--no-sync",
      "reason": "uruchomienie bez synchronizacji"
    },
    {
      "id": "uv-run-with",
      "kind": "deny",
      "pattern": "^\\s*uv\\s+run(?=\\s|$).*--with(?:-requirements|-editable)?(?=[\\s=]|$)",
      "reason": "`uv run --with` pobiera paczkę z sieci, także z `--no-sync` — zależności instaluj na PC albo w CI"
    },
    {
      "id": "uvx",
      "kind": "deny",
      "pattern": "^\\s*uvx(?=\\s|$)(?!(?:\\s+-\\S+)*\\s+--offline(?=\\s|$))",
      "reason": "`uvx` pobiera narzędzie z sieci — użyj `uvx --offline` / `UV_OFFLINE=1` albo `uv run --no-sync python -m …`"
    },
    {
      "id": "bun-pkg",
      "kind": "deny",
      "pattern": "^\\s*bun\\s+(?:install|add|remove|rm|i|a|update|up|upgrade)(?=\\s|$)",
      "reason": "instalacja paczek na serwerze — zależności zmieniają się na PC albo w CI"
    },
    {
      "id": "npm-pkg",
      "kind": "deny",
      "pattern": "^\\s*npm\\s+(?:install|i|ci|cit|install-ci-test|add|it|install-test|update|up|upgrade|remove|uninstall|un|rm|r)(?=\\s|$)",
      "reason": "instalacja paczek na serwerze — zależności zmieniają się na PC albo w CI"
    },
    {
      "id": "pnpm-pkg",
      "kind": "deny",
      "pattern": "^\\s*pnpm\\s+(?:install|i|add|update|up|upgrade|remove|rm)(?=\\s|$)",
      "reason": "instalacja paczek na serwerze — zależności zmieniają się na PC albo w CI"
    },
    {
      "id": "yarn-pkg",
      "kind": "deny",
      "pattern": "^\\s*yarn\\s+(?:global\\s+add|install|add|update|up|upgrade|remove)(?=\\s|$)",
      "reason": "instalacja paczek na serwerze — zależności zmieniają się na PC albo w CI"
    },
    {
      "id": "yarn-bare",
      "kind": "deny",
      "pattern": "^\\s*yarn(?=(?:\\s+(?:--cwd(?:=|\\s+)\\S+|-\\S+))*\\s*$)(?!.*\\s(?:-v|--version|-h|--help)(?=\\s|$))",
      "reason": "goły `yarn` instaluje zależności — instalacja tylko na PC albo w CI"
    },
    {
      "id": "shadcn",
      "kind": "deny",
      "pattern": "^\\s*shadcn(?:@\\S+)?\\s+(?:init|add)(?=\\s|$)",
      "reason": "`shadcn init|add` instaluje paczki sam — instalacja tylko na PC albo w CI"
    },
    {
      "id": "expo-install",
      "kind": "deny",
      "pattern": "^\\s*expo(?:@\\S+)?\\s+install(?=\\s|$)",
      "reason": "`expo install` zmienia zależności — instalacja tylko na PC albo w CI"
    },
    {
      "id": "cargo-install",
      "kind": "deny",
      "pattern": "^\\s*cargo\\s+install(?=\\s|$)",
      "reason": "instalacja na serwerze — zależności zmieniają się na PC albo w CI"
    },
    {
      "id": "go-install",
      "kind": "deny",
      "pattern": "^\\s*go\\s+install(?=\\s|$)",
      "reason": "instalacja na serwerze — zależności zmieniają się na PC albo w CI"
    },
    {
      "id": "apt-install",
      "kind": "deny",
      "pattern": "^\\s*apt(?:-get)?(?:\\s+-\\S+)*\\s+install(?=\\s|$)",
      "reason": "instalacja na serwerze — zależności zmieniają się na PC albo w CI"
    },
    {
      "id": "corepack-enable",
      "kind": "deny",
      "pattern": "^\\s*corepack\\s+enable(?=\\s|$)",
      "reason": "instalacja na serwerze — zależności zmieniają się na PC albo w CI"
    },
    {
      "id": "next-build",
      "kind": "deny",
      "pattern": "^\\s*next\\s+build(?=\\s|$)",
      "reason": "build produkcyjny tylko w CI — na VPS `tsc --noEmit`"
    },
    {
      "id": "expo-build",
      "kind": "deny",
      "pattern": "^\\s*expo(?:@\\S+)?\\s+(prebuild|export)(?=\\s|$)",
      "reason": "build produkcyjny tylko w CI"
    },
    {
      "id": "eas-build",
      "kind": "deny",
      "pattern": "^\\s*eas\\s+build(?=\\s|$)",
      "reason": "build produkcyjny tylko w CI"
    },
    {
      "id": "vite-build",
      "kind": "deny",
      "pattern": "^\\s*vite\\s+build(?=\\s|$)",
      "reason": "build produkcyjny tylko w CI"
    },
    {
      "id": "nuxt-build",
      "kind": "deny",
      "pattern": "^\\s*nuxt\\s+build(?=\\s|$)",
      "reason": "build produkcyjny tylko w CI"
    },
    {
      "id": "astro-build",
      "kind": "deny",
      "pattern": "^\\s*astro\\s+build(?=\\s|$)",
      "reason": "build produkcyjny tylko w CI"
    },
    {
      "id": "tsup",
      "kind": "deny",
      "pattern": "^\\s*tsup(?=\\s|$)",
      "reason": "build produkcyjny tylko w CI — na VPS `tsc --noEmit`"
    },
    {
      "id": "webpack",
      "kind": "deny",
      "pattern": "^\\s*webpack(?=\\s|$)",
      "reason": "build produkcyjny tylko w CI — na VPS `tsc --noEmit`"
    },
    {
      "id": "cargo-build",
      "kind": "deny",
      "pattern": "^\\s*cargo\\s+build(?=\\s|$)",
      "reason": "build produkcyjny tylko w CI — na VPS `cargo check`"
    },
    {
      "id": "turbo-build",
      "kind": "deny",
      "pattern": "^\\s*turbo(?:\\s+run)?(?:\\s+[^-\\s]\\S*)*?\\s+build(?=\\s|$)",
      "reason": "build produkcyjny tylko w CI — na VPS `turbo run lint` / `typecheck`"
    },
    {
      "id": "turbo-lint",
      "kind": "allow",
      "pattern": "^\\s*turbo\\s+run(?:\\s+(?:lint|typecheck))+(?:\\s+-\\S+(?:\\s+[^-\\s]\\S*)?)*\\s*$",
      "reason": "lekkie bramki na VPS"
    },
    {
      "id": "npx-launcher",
      "kind": "deny",
      "pattern": "^\\s*(?:npx|npm\\s+(?:exec|x))(?=\\s|$)",
      "reason": "`npx` / `npm exec` pobiera paczkę z sieci — użyj `npx --no <bin>`, `bunx --no-install <bin>` albo skryptu projektu (`bun run typecheck`)"
    },
    {
      "id": "npx-no",
      "kind": "allow",
      "pattern": "^\\s*(?:npx|npm\\s+(?:exec|x))(?=(?:\\s+-\\S+)*\\s+--no(?=\\s|$))(?!(?:\\s+-\\S+)*\\s+(?:-y|--yes)(?=\\s|$))",
      "reason": "`--no` przed nazwą: tylko pakiet już w node_modules/.bin, bez pobierania"
    },
    {
      "id": "bunx-launcher",
      "kind": "deny",
      "pattern": "^\\s*(?:bunx|bun\\s+x)(?=\\s|$)",
      "reason": "`bunx` pobiera paczkę z sieci — użyj `bunx --no-install <bin>` albo skryptu projektu (`bun run typecheck`)"
    },
    {
      "id": "bunx-no-install",
      "kind": "allow",
      "pattern": "^\\s*(?:bunx|bun\\s+x)(?=(?:\\s+-\\S+)*\\s+--no-install(?=\\s|$))",
      "reason": "`--no-install` przed nazwą: tylko pakiet już zainstalowany"
    },
    {
      "id": "dlx-launcher",
      "kind": "deny",
      "pattern": "^\\s*(?:pnpm\\s+dlx|yarn\\s+dlx|pnpx)(?=\\s|$)",
      "reason": "`pnpm dlx` / `yarn dlx` / `pnpx` zawsze pobiera paczkę — użyj skryptu projektu (`bun run typecheck`) albo `npx --no <bin>`"
    },
    {
      "id": "playwright",
      "kind": "deny",
      "pattern": "^\\s*(npx\\s+|bunx\\s+|yarn\\s+dlx\\s+|pnpm\\s+dlx\\s+)?playwright(?=\\s|$)",
      "reason": "przeglądarka to setki MB na instancję — e2e tylko w CI"
    },
    {
      "id": "cypress",
      "kind": "deny",
      "pattern": "^\\s*(npx\\s+|bunx\\s+)?cypress(?=\\s|$)",
      "reason": "przeglądarka to setki MB na instancję — e2e tylko w CI"
    },
    {
      "id": "maestro",
      "kind": "deny",
      "pattern": "^\\s*maestro(?=\\s|$)",
      "reason": "testy mobilne tylko w CI"
    },
    {
      "id": "pytest-xdist",
      "kind": "deny",
      "pattern": "^\\s*pytest(?=\\s|$).*\\s(?:-n(?:=?[a-zA-Z0-9]+)?|--numprocesses(?:=\\S+)?)(?=\\s|$)",
      "reason": "xdist mnoży procesy na słabym CPU — użyj `pytest` bez `-n`"
    }
  ],
  "project_deny": [],
  "project_allow": [],
  "wrappers": []
}
