{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/invoke-hook.js gate-destructive.sh",
        "matcher": "git\\s+(push|reset|clean|commit)|\\brm\\s+-[a-zA-Z]*r",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/invoke-hook.js gate-push.sh",
        "matcher": "git\\s+push"
      }
    ]
  }
}
