{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/invoke-hook.js git-guard.mjs --to cursor",
        "matcher": "git\\s+(push|reset|clean|branch|checkout)|\\brm\\s+-[a-zA-Z]*r|\\b(mv|cp|install|ln|dd|shred|truncate|touch|mkdir|rmdir|chmod|chown|chgrp|tee|unlink|sed)\\b|>",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/invoke-hook.js sensitive-files-guard.mjs --to cursor --tool Read",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/invoke-hook.js sensitive-files-guard.mjs --to cursor --tool Write",
        "matcher": "Write",
        "failClosed": true
      }
    ]
  }
}
