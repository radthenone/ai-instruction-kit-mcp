{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "\"C:/Program Files/Git/bin/bash.exe\" --noprofile --norc .cursor/hooks/gate-destructive.sh",
        "matcher": "git\\s+(push|reset|clean|commit)|\\brm\\s+-[a-zA-Z]*r",
        "failClosed": true
      },
      {
        "command": "\"C:/Program Files/Git/bin/bash.exe\" --noprofile --norc .cursor/hooks/gate-push.sh",
        "matcher": "git\\s+push"
      }
    ]
  }
}
