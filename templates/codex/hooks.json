{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|local_shell|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/invoke-hook.js\" git-guard.mjs --to codex"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/invoke-hook.js\" server-guard.mjs --to codex"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_playwright_.*|mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/invoke-hook.js\" server-guard.mjs --to codex"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/invoke-hook.js\" sensitive-files-guard.mjs --to codex"
          }
        ]
      }
    ]
  }
}
