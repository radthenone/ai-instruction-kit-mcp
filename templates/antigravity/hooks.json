{
  "kit-guards": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/invoke-hook.js git-guard.mjs --to antigravity",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node hooks/invoke-hook.js server-guard.mjs --to antigravity",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "call_mcp_tool|^mcp_",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/invoke-hook.js server-guard.mjs --to antigravity",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(view_file|write_to_file|replace_file_content|multi_replace_file_content|edit_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/invoke-hook.js sensitive-files-guard.mjs --to antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
