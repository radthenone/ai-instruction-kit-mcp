# Normalize every recognized text file to LF in the Git index and on disk.
# eol=lf also covers the working copy: bootstrap copies templates byte for byte,
# so a CRLF checkout on Windows would leak CRLF into target repos.
* text=auto eol=lf

# Executed by Linux CI: must remain LF even on Windows.
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Repository documentation and agent instructions.
*.md   text eol=lf

# Binary assets must never undergo EOL conversion.
*.png  -text
*.jpg  -text
*.jpeg -text
*.gif  -text
*.ico  -text
*.pdf  -text